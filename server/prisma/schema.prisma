datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// User accounts (Customer, Admin, Staff)
model User {
  id           String            @id @default(uuid())
  name         String
  email        String            @unique
  phone        String?           @unique
  passwordHash String?
  role         String            @default("USER") // USER, ADMIN, THEATRE_STAFF
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  bookings     Booking[]
  reservations SeatReservation[]

  @@map("users")
}

/// Movie catalogue metadata
model Movie {
  id            String     @id @default(uuid())
  title         String
  synopsis      String
  duration      Int        // Duration in minutes
  language      String     // e.g. "Telugu, Hindi, Tamil"
  genre         String     // e.g. "Action, Sci-Fi"
  certification String     @default("UA") // U, UA, A, R
  rating        Float      @default(8.5)
  posterUrl     String
  bannerUrl     String?
  releaseDate   DateTime?
  status        String     @default("now_showing") // now_showing, coming_soon
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  showtimes     Showtime[]

  @@map("movies")
}

/// Multiplex venue / Theatre
model Theatre {
  id           String     @id @default(uuid())
  name         String     // e.g., "PVR ICON: Phoenix Palladium, Lower Parel"
  chain        String     // "PVR", "INOX", "Cinépolis"
  city         String     // "Mumbai", "Delhi-NCR", etc.
  address      String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  screens      Screen[]

  @@map("theatres")
}

/// Auditorium screen within a theatre
model Screen {
  id           String     @id @default(uuid())
  theatreId    String
  name         String     // e.g., "Screen 1 - IMAX Laser 3D", "Screen 2 - Dolby Atmos 7.1"
  screenNumber Int
  format       String     @default("2D") // "IMAX 3D", "Dolby Atmos 7.1", "4DX", "2D"
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  theatre      Theatre    @relation(fields: [theatreId], references: [id], onDelete: Cascade)
  seats        Seat[]
  showtimes    Showtime[]

  @@map("screens")
}

/// Physical seat in an auditorium screen
model Seat {
  id           String            @id @default(uuid())
  screenId     String
  row          String            // "A", "B", ... "H"
  number       Int               // 1 to 16
  seatNumber   String            // "A1", "A2", etc.
  tier         String            @default("EXECUTIVE") // "RECLINER", "PRIME", "EXECUTIVE"
  basePrice    Float             @default(220.0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  screen       Screen            @relation(fields: [screenId], references: [id], onDelete: Cascade)
  reservations SeatReservation[]

  @@unique([screenId, row, number])
  @@map("seats")
}

/// Screening instance of a movie in a screen
model Showtime {
  id           String            @id @default(uuid())
  movieId      String
  screenId     String
  startTime    DateTime
  endTime      DateTime
  date         String            // "2026-10-04"
  time         String            // "07:30 PM"
  language     String            @default("Hindi")
  format       String            @default("2D")
  cancellable  Boolean           @default(true)
  subtitles    Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  movie        Movie             @relation(fields: [movieId], references: [id], onDelete: Cascade)
  screen       Screen            @relation(fields: [screenId], references: [id], onDelete: Cascade)
  reservations SeatReservation[]
  bookings     Booking[]

  @@map("showtimes")
}

/// Real-time seat concurrency lock & booking state
model SeatReservation {
  id                  String     @id @default(uuid())
  showtimeId          String
  seatId              String
  status              String     @default("AVAILABLE") // "AVAILABLE", "HELD", "BOOKED"
  heldBy              String?    // Session ID or User ID who holds the seat
  heldExpiresAt       DateTime?  // 10-minute hold timestamp
  lockedBySessionId   String?    // backwards compatible alias
  lockedByUserId      String?    // backwards compatible alias
  lockedUntil         DateTime?  // backwards compatible alias
  bookingId           String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  showtime            Showtime   @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  seat                Seat       @relation(fields: [seatId], references: [id], onDelete: Cascade)
  user                User?      @relation(fields: [lockedByUserId], references: [id], onDelete: SetNull)
  booking             Booking?   @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@unique([showtimeId, seatId])
  @@map("seat_reservations")
}

/// Customer ticket booking record
model Booking {
  id             String            @id @default(uuid())
  bookingRef     String            @unique // E.g., "BMS-849204-KL"
  userId         String?
  showtimeId     String
  customerName   String
  customerEmail  String
  customerPhone  String
  seatsCount     Int
  seatIds        String            // Comma-separated: "A1, A2"
  seatDetails    String?           // JSON string of seats with tiers and individual prices
  baseAmount     Float
  convenienceFee Float
  gstAmount      Float
  donationAmount Float             @default(0.0)
  discountAmount Float             @default(0.0)
  totalAmount    Float
  status         String            @default("PENDING") // "PENDING", "CONFIRMED", "CHECKED_IN", "CANCELLED", "EXPIRED"
  refundStatus   String?           @default("NOT_REQUESTED") // "NOT_REQUESTED", "REFUND_PENDING", "REFUND_PROCESSING", "REFUNDED", "REFUND_FAILED"
  refundAmount   Float?            @default(0.0)
  cancellationFee Float?           @default(0.0)
  refundId       String?
  cancelledAt    DateTime?
  qrCodeData     String            // Encrypted / signed payload for M-Ticket
  checkedInAt    DateTime?
  paymentMethod  String            @default("UPI")
  paymentId      String?           @unique
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user           User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  showtime       Showtime          @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  payment        Payment?          @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  reservations   SeatReservation[]

  @@map("bookings")
}

/// Financial transaction record with Razorpay / Stripe
model Payment {
  id            String    @id @default(uuid())
  bookingId     String?   @unique
  provider      String    @default("RAZORPAY") // "RAZORPAY" or "STRIPE"
  orderId       String    @unique // Gateway order_id or payment_intent_id
  paymentId     String?   // Gateway payment_id
  signature     String?   // HMAC SHA256 signature
  amount        Float
  currency      String    @default("INR")
  status        String    @default("PENDING") // "PENDING", "SUCCESS", "FAILED", "REFUNDED", "REFUND_PENDING", "REFUND_FAILED"
  refundId      String?   // Gateway refund ID (e.g., rfd_...)
  refundAmount  Float?
  metadata      String?   // JSON string of webhook payload / gateway response
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  booking       Booking?

  @@map("payments")
}

# CineBook Server Environment Configuration
PORT=5000
NODE_ENV=development

# JWT Secret for User/Admin Session Tokens (Replace with strong random secret in production)
JWT_SECRET=your_jwt_secret_change_me_in_production
JWT_EXPIRES_IN=7d

# Supabase / PostgreSQL Connection URL
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# If left empty, CineBook automatically runs with built-in zero-config local storage
DATABASE_URL=

# CORS Origin for Frontend
CLIENT_ORIGIN=http://localhost:5173

// Prisma Schema for BookMyShow Clone (Production-Grade Cinema Ticketing Platform)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum Role {
  USER
  THEATRE_ADMIN
  SUPERADMIN
}

enum SoundType {
  DOLBY_ATMOS
  IMAX
  FOUR_DX
  STANDARD
}

enum Certification {
  U
  UA
  A
  R
}

enum SeatTier {
  SILVER
  GOLD
  VIP_RECLINER
}

enum ReservationStatus {
  AVAILABLE
  HELD
  BOOKED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum PaymentProvider {
  RAZORPAY
  STRIPE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

// ----------------------------------------------------
// MODELS
// ----------------------------------------------------

/// User account with role-based access control
model User {
  id           String            @id @default(uuid())
  name         String
  email        String            @unique
  phone        String?           @unique
  passwordHash String?
  role         Role              @default(USER)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  // Relations
  bookings     Booking[]
  reservations SeatReservation[]

  @@index([email])
  @@index([role])
  @@map("users")
}

/// Geographic city where theatres are located
model City {
  id        String   @id @default(uuid())
  name      String
  state     String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  cinemas   Cinema[]

  @@index([slug])
  @@map("cities")
}

/// Cinema / Multiplex complex (e.g., PVR, INOX, Cinépolis)
model Cinema {
  id           String   @id @default(uuid())
  name         String
  address      String
  cityId       String
  totalScreens Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  city         City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  screens      Screen[]

  @@index([cityId])
  @@map("cinemas")
}

/// Individual auditorium / hall within a cinema
model Screen {
  id           String    @id @default(uuid())
  cinemaId     String
  screenNumber Int
  soundType    SoundType @default(STANDARD)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  cinema       Cinema     @relation(fields: [cinemaId], references: [id], onDelete: Cascade)
  seats        Seat[]
  showtimes    Showtime[]

  @@unique([cinemaId, screenNumber])
  @@index([cinemaId])
  @@map("screens")
}

/// Movie catalogue metadata
model Movie {
  id            String        @id @default(uuid())
  title         String
  synopsis      String        @db.Text
  duration      Int           // Duration in minutes
  language      String
  genre         String[]      // Array of genres e.g., ["Action", "Sci-Fi"]
  certification Certification @default(UA)
  posterUrl     String
  bannerUrl     String
  releaseDate   DateTime
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  showtimes     Showtime[]

  @@index([releaseDate])
  @@index([language])
  @@map("movies")
}

/// Specific screening instance of a movie in a screen
model Showtime {
  id          String   @id @default(uuid())
  movieId     String
  screenId    String
  startTime   DateTime
  endTime     DateTime
  date        DateTime @db.Date
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  movie        Movie             @relation(fields: [movieId], references: [id], onDelete: Cascade)
  screen       Screen            @relation(fields: [screenId], references: [id], onDelete: Cascade)
  reservations SeatReservation[]
  bookings     Booking[]

  @@index([movieId, date])
  @@index([screenId, date])
  @@index([startTime])
  @@map("showtimes")
}

/// Physical seat in an auditorium screen layout
model Seat {
  id        String   @id @default(uuid())
  screenId  String
  row       String   // e.g., "A", "B", ... "J"
  number    Int      // e.g., 1 to 20
  tier      SeatTier @default(SILVER)
  basePrice Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  screen       Screen            @relation(fields: [screenId], references: [id], onDelete: Cascade)
  reservations SeatReservation[]

  @@unique([screenId, row, number])
  @@index([screenId, tier])
  @@map("seats")
}

/// High-concurrency seat reservation state per showtime
model SeatReservation {
  id           String            @id @default(uuid())
  showtimeId   String
  seatId       String
  status       ReservationStatus @default(AVAILABLE)
  heldByUserId String?
  heldUntil    DateTime?         // TTL timestamp (e.g., 10 mins from hold acquisition)
  bookingId    String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  // Relations
  showtime     Showtime          @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  seat         Seat              @relation(fields: [seatId], references: [id], onDelete: Cascade)
  heldByUser   User?             @relation(fields: [heldByUserId], references: [id], onDelete: SetNull)
  booking      Booking?          @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  // Compound unique constraint to guarantee no two records for same showtime and seat
  @@unique([showtimeId, seatId])
  @@index([showtimeId, status])
  @@index([heldUntil])
  @@index([heldByUserId])
  @@map("seat_reservations")
}

/// Confirmed or pending customer ticket booking
model Booking {
  id             String        @id @default(uuid())
  bookingRef     String        @unique // E.g., "BMS-849204-KL"
  userId         String
  showtimeId     String
  totalAmount    Decimal       @db.Decimal(10, 2)
  taxAmount      Decimal       @db.Decimal(10, 2)
  convenienceFee Decimal       @db.Decimal(10, 2)
  status         BookingStatus @default(PENDING)
  paymentId      String?       @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  showtime       Showtime          @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  payment        Payment?          @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  reservations   SeatReservation[]

  @@index([userId])
  @@index([showtimeId])
  @@index([status])
  @@index([createdAt])
  @@map("bookings")
}

/// Financial transaction record with Razorpay / Stripe
model Payment {
  id            String          @id @default(uuid())
  bookingId     String?         @unique
  provider      PaymentProvider
  transactionId String          @unique // Gateway order_id or payment_intent_id
  amount        Decimal         @db.Decimal(10, 2)
  status        PaymentStatus   @default(PENDING)
  metadata      Json?           // Full webhook payload / signature details
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Relations
  booking       Booking?

  @@index([transactionId])
  @@index([status])
  @@map("payments")
}
